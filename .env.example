# ---------------------------------------------------------------------------
# GroundCheck — configuration
# Copy to .env and edit. Everything has a safe default; nothing here is required
# to boot (no model => heuristic fallback; no LLM key => mock judge).
# ---------------------------------------------------------------------------

# --- Detector (inference) ---
# Local dir or Hugging Face id of the fine-tuned model. Empty => heuristic fallback.
GROUNDCHECK_MODEL_PATH=
GROUNDCHECK_BACKEND=auto          # auto | model | heuristic
GROUNDCHECK_THRESHOLD=0.5         # grounded if grounded_score >= threshold
GROUNDCHECK_MAX_LENGTH=2048       # token cap for (question + source + answer)
GROUNDCHECK_DEVICE=auto           # auto | cpu | cuda

# --- LLM-as-judge baseline (benchmark only) ---
# OpenAI-compatible; same key works for the synthetic hard-case generator in train/.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=                      # empty => deterministic mock judge
LLM_TEMPERATURE=0.0

# Judge pricing for the $-per-1k cost model ($ per 1M tokens). Defaults ≈ Groq Llama-3.3-70B.
JUDGE_PRICE_IN_PER_MTOK=0.59
JUDGE_PRICE_OUT_PER_MTOK=0.79
