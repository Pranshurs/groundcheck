# ---------------------------------------------------------------------------
# GroundCheck — configuration
# Copy to .env and edit. Everything has a default; nothing here is required.
# The detector loads the published model; if it cannot, it fails instead of guessing.
# ---------------------------------------------------------------------------

# --- Detector (inference) ---
# Local dir or Hugging Face id. Empty => the published model, pinned to its revision.
GROUNDCHECK_MODEL_PATH=
GROUNDCHECK_MODEL_REVISION=       # empty => pinned revision for the published model
GROUNDCHECK_BACKEND=model         # model | heuristic (heuristic = lexical-overlap baseline)
GROUNDCHECK_THRESHOLD=0.5         # grounded if grounded_score >= threshold
GROUNDCHECK_MAX_LENGTH=512        # token cap for (question + source, answer); trained at 512
GROUNDCHECK_DEVICE=auto           # auto | cpu | cuda

# --- LLM-as-judge baseline (benchmark only) ---
# OpenAI-compatible (Groq, OpenAI, OpenRouter, Ollama).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=                      # empty => deterministic mock judge
LLM_TEMPERATURE=0.0

# Judge pricing for the $-per-1k cost model ($ per 1M tokens). Defaults ≈ Groq Llama-3.3-70B.
JUDGE_PRICE_IN_PER_MTOK=0.59
JUDGE_PRICE_OUT_PER_MTOK=0.79
